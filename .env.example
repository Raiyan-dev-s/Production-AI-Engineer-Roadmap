# =============================================================================
# Production AI Engineering - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# Application
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis (for caching, queues, sessions)
# REDIS_URL=redis://localhost:6379/0

# LLM API Keys (add keys for providers you use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...

# Vector Database (for RAG projects)
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# VECTOR_DB_URL=http://localhost:6333

# Security
SECRET_KEY=change-me-in-production-use-a-real-secret
# JWT_SECRET_KEY=change-me-in-production

# Rate Limiting
# RATE_LIMIT_PER_MINUTE=60

# CORS
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Monitoring (optional)
# SENTRY_DSN=https://...
# DATADOG_API_KEY=...
